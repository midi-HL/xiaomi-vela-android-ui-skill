.row { width: 100%; min-height: 62px; border-radius:14px; flex-direction: row; align-items: center; justify-content: space-between; padding: 10px 12px; } .copy { flex: 1; flex-direction: column; } .title { font-size: 14px; } .sub { font-size: 10px; } .tail { font-size: 20px; margin-left: 8px; }
</style>
