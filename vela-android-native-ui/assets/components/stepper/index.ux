<template>
<div class="row"><text class="control" style="color: {{accent}};" @click="down">−</text><text class="value" style="color: {{foreground}};">{{value}}</text><text class="control" style="color: {{accent}};" @click="up">＋</text></div>
</template>
<style>
.row { flex-direction: row; align-items: center; justify-content: center; } .control { width: 44px; height: 44px; text-align: center; font-size: 20px; } .value { width: 48px; text-align: center; font-size: 14px; }
</style>
<script>
export default {
  props: ['value', 'min', 'max', 'step', 'accent', 'foreground'],
  data: { value: 24, min: 22, max: 26, step: 2, accent:"#356DFF", foreground:"#1C1B1F" }, down() { this.update(-1) }, up() { this.update(1) }, update(d) { this.value = Math.max(this.min, Math.min(this.max, this.value + d * this.step)); this.$emit("change", this.value) }
}
</script>
