<template>
<div class="row" @click="toggle"><div class="outer" style="border-color: {{accent}};"><div if="{{checked}}" class="inner" style="background-color: {{accent}};"></div></div><text class="label" style="color: {{foreground}};">{{label}}</text></div>
</template>
<style>
.row { flex-direction: row; align-items: center; min-height: 44px; } .outer { width: 22px; height: 22px; border-width: 2px; border-style: solid; border-radius: 12px; align-items: center; justify-content: center; } .inner { width: 12px; height: 12px; border-radius: 6px; } .label { margin-left: 10px; font-size: 12px; }
</style>
<script>
export default {
  props: ['label', 'checked', 'accent', 'foreground'],
  data: { label: "选项", checked: false, accent: "#356DFF", foreground:"#1C1B1F" }, toggle() { this.checked = !this.checked; this.$emit("change", this.checked) }
}
</script>
