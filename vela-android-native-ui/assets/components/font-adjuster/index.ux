<template>
<div class="adjuster"><text class="button" style="color: {{accent}};" @click="shift(-1)">A−</text><text class="value" style="color: {{foreground}};">{{value}} px</text><text class="button" style="color: {{accent}};" @click="shift(1)">A＋</text></div>
</template>
<style>
.adjuster { flex-direction: row; align-items: center; justify-content: space-between; } .button { font-size: 14px; } .value { font-size: 12px; }
</style>
<script>
export default {
  props: ['value', 'min', 'max', 'step', 'accent', 'foreground'],
  data: { value: 24, min: 22, max: 26, step: 2, large: 26, accent:"#356DFF", foreground:"#1C1B1F" }, shift(d) { this.value = Math.max(this.min, Math.min(this.max, this.value + d * this.step)); this.large = Math.min(this.max, this.value + 2); this.$emit("change", { base: this.value, large: this.large, scale: this.value / 24 }) }
}
</script>
